{"id":"20261022T132724.945-sqtws8/1","space":"c64","name":"inc16","params":"dst","body":"        inc .dst\n        bne +\n        inc .dst+1\n+","comment":"Adds 1 to the 16-bit value at dst.","origin":"llm","added":"20261022T132724.945-sqtws8","closed":null}
{"id":"20261022T132724.945-sqtws8/3","space":"c64","name":"mov16","params":"dst, src","body":"        lda .src\n        sta .dst\n        lda .src+1\n        sta .dst+1","comment":"Copies the 16-bit value at src to dst. It changes A.","origin":"llm","added":"20261022T132724.945-sqtws8","closed":null}
{"id":"20261022T132724.945-sqtws8/2","space":"c64","name":"set16","params":"dst, value","body":"        lda #<.value\n        sta .dst\n        lda #>.value\n        sta .dst+1","comment":"Puts the 16-bit value at dst. It changes A.","origin":"llm","added":"20261022T132724.945-sqtws8","closed":null}
