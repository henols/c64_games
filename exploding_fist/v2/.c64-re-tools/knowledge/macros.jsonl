{"id":"20261022T104543.905-o1bqdy/2","space":"c64","name":"inc16","params":"dst","body":"inc .dst\nbne .done\ninc .dst+1\n.done","comment":"Adds 1 to the 16-bit value at dst.","origin":"llm","added":"20261022T104543.905-o1bqdy","closed":null}
