  "comments": [
    {"at":0,"placement":"line","text":"Unpacks the bitmap of scene stage_counter AND 3 backwards into $e640-$f53f. The data starts with its length. Called by scene_draw_if_new."},
    {"at":19,"placement":"side","text":"Adds the stored length: the unpacker reads from the end of the data."},
    {"at":34,"placement":"side","text":"The bitmap rows 5-16 end at $f53f."},
    {"at":46,"placement":"side","text":"A zero control byte ends the data."},
    {"at":48,"placement":"side","text":"Bit 7 set: a run of one value."},
    {"at":50,"placement":"side","text":"Bit 7 clear: a block of literal bytes."},
    {"at":98,"placement":"line","text":"Moves scene_dest_ptr down by scene_run_length. Called by scene_unpack_bitmap."},
    {"at":112,"placement":"line","text":"Moves scene_src_ptr down by scene_run_length plus 1 (CLC before SBC). Called by scene_unpack_bitmap."},
    {"at":126,"placement":"line","text":"Start of the packed bitmap of each scene. The first word of each block is its length."}
  ],
