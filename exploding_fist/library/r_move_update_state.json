    {"at":20,"placement":"side","text":"Freeze the pose until the delay ends"},
    {"at":52,"placement":"side","text":"Back kick input: start with the about turn $12"},
    {"at":61,"placement":"side","text":"Moves $07, $10, $0a start from a crouch"},
    {"at":103,"placement":"side","text":"Crouch must hold its end pose"},
    {"at":135,"placement":"side","text":"About turn complete: back kick $11"},
    {"at":152,"placement":"side","text":"Back kick ended: return with move $15 backwards"},
    {"at":171,"placement":"side","text":"Bit 7: switch at once, 0: retract, 1: run to the end"}
