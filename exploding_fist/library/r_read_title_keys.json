  "comments": [
    {"at":0,"placement":"line","text":"Reads keyboard column 0 and fire on port 2. F1 or fire starts a game from the demo, F3 changes 1 or 2 players, F5 goes to the title. Returns A = $80 to start."},
    {"at":15,"placement":"side","text":"Acts only when the key row changes."},
    {"at":89,"placement":"side","text":"F7 does nothing."},
    {"at":92,"placement":"side","text":"F5 works also during a game; the stack is not reset."},
    {"at":95,"placement":"line","text":"Title loop: one player, then the high score, the mode text and the demo again and again. A start key or fire starts the game of two_player_mode."},
    {"at":122,"placement":"side","text":"N clear: the demo ended without a start key."},
    {"at":132,"placement":"side","text":"No mode 2 or more exists."},
    {"at":136,"placement":"side","text":"Fire held at the end starts a new one-player game."}
  ],
