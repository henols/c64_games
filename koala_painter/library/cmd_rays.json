  "comments": [
    {"at":0,"placement":"line","text":"Command 6 (Rays): lines from one centre point. The centre comes from $1168. While a button is down, it draws a line from the centre to the cursor ($2788) at each read. While the buttons are up, a band line follows the cursor ($2793). It sets brush_plot_flag to 1 and puts it back at the end. A long press with no touch goes back to the menu ($1495)."},
    {"at":5,"placement":"side","text":"brush_plot_flag = 1 during Rays"},
    {"at":61,"placement":"side","text":"shape_x1/shape_y1 = cursor"},
    {"at":116,"placement":"side","text":"remove the band line at the old point"},
    {"at":125,"placement":"side","text":"draw the band line at the new point"},
    {"at":133,"placement":"side","text":"remove the band line, then draw the real line"}
  ],
