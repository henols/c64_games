  "comments": [
    {"at":0,"placement":"line","text":"Converts pad units to screen units: X = (pad X - 20) * 4 / 5 (0-$9f), Y = pad Y - 20 (0-$c7). Values out of range become the limit. Input and output: X, Y."},
    {"at":57,"placement":"line","text":"Puts A * 4 in temp_word/temp_word_hi (16 bits)."},
    {"at":72,"placement":"line","text":"Divides the 16-bit value in temp_word/temp_word_hi by 5 (temp_word_hi must be below 5). Returns A = the quotient (8 bits); temp_word_hi keeps the remainder."}
