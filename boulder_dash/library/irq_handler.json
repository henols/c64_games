  "comments": [
    {"at":0,"placement":"line","text":"Raster IRQ. Sets two raster splits from the tables at $54-$5b, scans keyboard rows 0 and 7, then does the title or game frame work."},
    {"at":18,"placement":"side","text":"The split index selects the VIC-II values of the next split."},
    {"at":43,"placement":"side","text":"Keyboard row 0: a value counts when two scans agree."},
    {"at":65,"placement":"side","text":"Keyboard row 7: a value counts when two scans agree."},
    {"at":90,"placement":"side","text":"irq_mode 1: title frame work."},
    {"at":100,"placement":"side","text":"Without the credits the upper split shows the screen at $0800."},
    {"at":120,"placement":"side","text":"irq_mode 0: game frame work with sprites 0-6."},
    {"at":143,"placement":"line","text":"Reads $dc01 with no keyboard column selected. A joystick 1 input sets all key values to $ff and skips the keyboard scan."},
    {"at":167,"placement":"side","text":"Drops the return address and continues in the IRQ handler."}
  ],
