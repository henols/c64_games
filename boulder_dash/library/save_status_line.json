  "comments": [
    {"at":0,"placement":"line","text":"Copies the left halves of the 20 double-width characters of screen row 0 to saved_status_line."},
    {"at":18,"placement":"line","text":"Shows the 20-character line at text_ptr in screen row 0 as double-width characters (c and c+$34). Sets the colours of the two count fields."},
    {"at":24,"placement":"side","text":"Character 3 is the diamond symbol only in the game status line."},
    {"at":28,"placement":"side","text":"Yellow for the collected count."},
    {"at":33,"placement":"side","text":"Colour of screen columns 14-17 (characters 7-8)."},
    {"at":45,"placement":"side","text":"Codes $19 and up (the diamond symbol) give white, digits give yellow."},
    {"at":54,"placement":"side","text":"Colour of screen columns 2-5 (characters 1-2)."},
    {"at":70,"placement":"side","text":"Shows code $01 as code $20."},
    {"at":77,"placement":"side","text":"The right half of a character is the left half plus $34."}
  ],
