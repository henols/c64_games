  "comments": [
    {"at":0,"placement":"line","text":"Copies the 240 bytes of cave data to cave_data when the cave changed. Sets the level seed and the cave colours."},
    {"at":10,"placement":"side","text":"The intermission flag of the cave."},
    {"at":16,"placement":"side","text":"Cave data address: $582E plus the offset of the cave."},
    {"at":71,"placement":"side","text":"Colour RAM value of the cave cells."},
    {"at":78,"placement":"line","text":"Sets the variables for the play of a cave: counters, delay, time, diamonds needed, diamond values, birth countdown, amoeba speed and animations."},
    {"at":110,"placement":"side","text":"Gives the magic wall back its brick graphics."},
    {"at":113,"placement":"side","text":"Row delay of the level."},
    {"at":132,"placement":"side","text":"Time digits to the status line."},
    {"at":223,"placement":"side","text":"Rockford appears after 4 seconds."},
    {"at":239,"placement":"side","text":"Two players with one joystick get 6 seconds."},
    {"at":255,"placement":"side","text":"Intermissions animate all three groups."}
