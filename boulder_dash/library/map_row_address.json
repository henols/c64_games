  "comments": [
    {"at":0,"placement":"line","text":"Address of each of the 24 map rows: $0800 plus 40 times the row. Rows 0-1 are the status rows."},
    {"at":48,"placement":"line","text":"Sets draw_ptr to the map cell at column object_x, row object_y."},
    {"at":68,"placement":"line","text":"Writes object_element to the map cell at object_x, object_y."},
    {"at":78,"placement":"line","text":"Map offset of one step in each direction 0-7: up, up right, right, down right, down, down left, left, up left."},
    {"at":94,"placement":"line","text":"Writes object_element to draw_count cells from draw_ptr in direction A. Input: A is direction 0-7."},
    {"at":133,"placement":"line","text":"Draws a line object: object_width cells in direction object_height from object_x, object_y."},
    {"at":146,"placement":"line","text":"Fills object_width by object_height cells from object_x, object_y with object_element."},
    {"at":186,"placement":"line","text":"Draws a box with an edge of object_element and an inside of object_fill."},
    {"at":209,"placement":"line","text":"Draws the edge of a box of object_width by object_height cells: right, down, left, then up."},
    {"at":257,"placement":"line","text":"Adds 3 to Y and stores it in object_index: the next object."},
    {"at":263,"placement":"line","text":"Adds 5 to Y and stores it in object_index."},
    {"at":269,"placement":"line","text":"Adds 6 to Y and stores it in object_index."},
    {"at":274,"placement":"line","text":"Draws the object list of the cave until $FF. Bits 7-6: point, line, filled box, box. Bits 5-0: the element."},
    {"at":291,"placement":"side","text":"Element $25 is the inbox: its cell is the start of Rockford."},
    {"at":335,"placement":"side","text":"Kind 0: point, 3 bytes."},
    {"at":346,"placement":"side","text":"Kind 1: line, 5 bytes."},
    {"at":359,"placement":"side","text":"Kind 2: filled box, 6 bytes."},
    {"at":372,"placement":"side","text":"Kind 3: box, 5 bytes."}
  ],
