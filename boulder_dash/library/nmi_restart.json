  "comments": [
    {"at":0,"placement":"line","text":"NMI vector target: RESTORE enables interrupts and restarts the game at the cold start."},
    {"at":1,"placement":"line","text":"Entry. Sets the stack, CIAs, NMI vector and $01, resets the variables, copies the screen drawer to $9e00, then runs title and game."},
    {"at":4,"placement":"side","text":"Disables all CIA interrupts."},
    {"at":56,"placement":"side","text":"RAM at $a000, I/O at $d000, KERNAL ROM."},
    {"at":70,"placement":"side","text":"Copies $7b58-$7d57 to $9e00-$9fff."},
    {"at":96,"placement":"side","text":"Start of the view in the cell graphics: $4003."},
    {"at":104,"placement":"side","text":"Status line text: PLAYER 1, 3 MEN, cave A."},
    {"at":115,"placement":"side","text":"Score digits 000000."},
    {"at":125,"placement":"side","text":"No cave selected: title, else play a cave."},
    {"at":143,"placement":"side","text":"Fills the play screen with character $7c."},
    {"at":171,"placement":"side","text":"Starts the voice 1 sustain value."},
    {"at":176,"placement":"side","text":"demo_mode plays the demo, else a player plays."},
    {"at":197,"placement":"side","text":"Shows the end of the cave and the next state."},
    {"at":200,"placement":"side","text":"Clears character 0 of the text charset."}
  ],
