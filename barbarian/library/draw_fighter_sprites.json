  "comments": [
    {"at":0,"placement":"line","text":"Builds the sprites of both fighters from their frames. Fighter 1 first, from sprite 7 down. Switches off each free sprite without an animation."},
    {"at":3,"placement":"side","text":"Next free sprite slot = 7."},
    {"at":7,"placement":"side","text":"Frame pointer from the table $bd80, indexed by fighter_frame."},
    {"at":23,"placement":"side","text":"A fighter at column $1e or more gets no sprites."},
    {"at":29,"placement":"side","text":"Frame byte 11: number of sprites. The 4-byte sprite entries start at byte 12."},
    {"at":38,"placement":"side","text":"Fighter 0: a first shape of $33 or more skips the first entry."},
    {"at":72,"placement":"side","text":"Slots below the last used slot."},
    {"at":74,"placement":"side","text":"Keeps a sprite that has an animation."},
    {"at":91,"placement":"line","text":"Sets sprite slot sprite_slot from one 4-byte frame entry at ($89),Y: shape, colour, Y position, X offset. Input: cur_fighter. Output: Y past the entry."},
    {"at":99,"placement":"side","text":"Shape + $20: sprite pointer. Shapes below $53 add $0d when the fighter faces left."},
    {"at":108,"placement":"side","text":"Stores the sprite pointer and switches the sprite on."},
    {"at":122,"placement":"side","text":"Bit 7 set: own colour and multicolour."},
    {"at":135,"placement":"side","text":"Colour of the opponent level from the table $c89a, single colour."},
    {"at":157,"placement":"side","text":"Y position."},
    {"at":167,"placement":"line","text":"Sets the X position of sprite slot sprite_slot. X = fighter column * 8 + offset ($89),Y + $18. Mirrors the offset for a fighter that faces left. Input: cur_fighter."},
    {"at":177,"placement":"side","text":"Faces left: offset = $30 - offset."},
    {"at":207,"placement":"side","text":"Bit 8 of the X position."}
  ],
