  "comments": [
    {"at":0,"placement":"line","text":"Looks for a fighter in move $88 while no loser is set. Then starts the decapitation of that fighter."},
    {"at":19,"placement":"line","text":"Sets the loser and starts sprites 0-2 at its position: the head (animation by facing) and animations $83 and $82."},
    {"at":20,"placement":"side","text":"loser_flag = fighter | $80."},
    {"at":27,"placement":"side","text":"Head animation $84 or $85, by fighter_facing."},
    {"at":43,"placement":"side","text":"Movement paths from $cde4 and $cde6 by facing, and $80."},
    {"at":62,"placement":"side","text":"Resets the path and animation state of sprites 0-2."},
    {"at":84,"placement":"side","text":"X = fighter column * 8 + $cdda,facing ($38 or $04)."},
    {"at":119,"placement":"side","text":"Bit 8 of the X position of sprites 0-2."},
    {"at":128,"placement":"side","text":"Y = $9d for sprites 0 and 2, $cd for sprite 1."},
    {"at":139,"placement":"line","text":"Sets winner_flag to the other fighter. Starts move $93 for the winner. The winner gets move $9c instead when the loser is not in move $88 and the distance is below 2."},
    {"at":147,"placement":"side","text":"winner_flag = loser_flag EOR 1: bit 7 stays set."},
    {"at":183,"placement":"line","text":"Waits until the loser lies in frame $59 or $14. Then starts sprites 3 and 4 at the left edge. Sets goblin_active."},
    {"at":205,"placement":"side","text":"Clears the X bit 8 of sprites 3 and 4."},
    {"at":212,"placement":"side","text":"Sprites 3 and 4 at X $27, Y $b8 and $cd."},
    {"at":228,"placement":"side","text":"Animations $86 and $87, movement path $85."},
    {"at":262,"placement":"side","text":"goblin_active = $ff."}
  ],
