  "comments": [
    {"at":0,"placement":"line","text":"Draws text A ($80 and up) from the pointer table $ba78 into the bitmap. A record: column, row, colour, characters, $0d starts a new record."},
    {"at":0,"placement":"side","text":"Text number * 2: the bit 7 of A drops out."},
    {"at":14,"placement":"side","text":"Record byte 0: column."},
    {"at":20,"placement":"side","text":"Bitmap address = column * 8 + row address."},
    {"at":65,"placement":"side","text":"Reads the next character code of the text."},
    {"at":68,"placement":"side","text":"$0d starts a new text record: column, row and colour."},
    {"at":72,"placement":"side","text":"Codes $41-$5a are the letters A-Z."},
    {"at":80,"placement":"side","text":"A letter becomes glyph number 1-26."},
    {"at":82,"placement":"side","text":"A holds the glyph number."},
    {"at":89,"placement":"side","text":"Copies one glyph row into the bitmap."},
    {"at":91,"placement":"side","text":"Sets bit 0 of each pixel pair: glyph pixels become %11, other pixels %01."},
    {"at":102,"placement":"side","text":"Screen RAM gets the high nibble of the colour byte."},
    {"at":110,"placement":"side","text":"Adds $94 to the screen pointer high byte: $44xx becomes colour RAM $d8xx."},
    {"at":118,"placement":"side","text":"Colour RAM gets the low nibble of the colour byte."},
    {"at":131,"placement":"side","text":"Moves the bitmap pointer to the next 8x8 cell."},
    {"at":145,"placement":"line","text":"Looks up a digit, space or bracket in the table at $bc22. Another code ends the text."},
    {"at":152,"placement":"side","text":"Gets the glyph number of the special character from the table at $bc2f."},
    {"at":162,"placement":"line","text":"Sets glyph_ptr ($73/$74) to $e800 + A * 8, the glyph of character A in the font at $e800."}
  ],
