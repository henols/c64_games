  "comments": [
    {"at":0,"placement":"line","text":"Runs only when end_sequence bit 7 is set. Starts sprites 0-3 from record end_figure_set of the table $cc9d. The main loop calls it each frame."},
    {"at":4,"placement":"side","text":"Pointer to the 12-byte record: 4 animations, 4 X positions, 4 Y positions."},
    {"at":21,"placement":"side","text":"Record byte 0 goes to sprite 3, byte 3 to sprite 0."},
    {"at":23,"placement":"side","text":"Animation of the sprite: 0 switches the sprite off."},
    {"at":40,"placement":"side","text":"Restarts the animation at its first step."},
    {"at":61,"placement":"side","text":"X position from record byte 4-7."},
    {"at":70,"placement":"side","text":"Y position from record byte 8-11, plus $a2."},
    {"at":84,"placement":"side","text":"Sets the X bit 8 of sprites 0-3."}
