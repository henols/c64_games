  "comments": [
    {"at":0,"placement":"line","text":"After a kill, waits until the loser is at X $28 or more. Then the winner turns and walks back to its start position."},
    {"at":25,"placement":"side","text":"Move $1d: turns the fighter."},
    {"at":37,"placement":"side","text":"Move $02: walks back."},
    {"at":50,"placement":"line","text":"The winner is at its start position: resets both fighters and starts the walk-in of the next bout."},
    {"at":97,"placement":"side","text":"The computer lost and the images are mirrored: mirrors them back."},
    {"at":103,"placement":"side","text":"Demo: changes the background and continues."},
    {"at":109,"placement":"side","text":"Two-player game: the game ends after one bout."},
    {"at":124,"placement":"side","text":"Player lost: waits 200 frames and starts the demo again."},
    {"at":134,"placement":"side","text":"After opponent 7, the final stage starts."},
    {"at":145,"placement":"side","text":"Changes to the other background picture."},
    {"at":149,"placement":"line","text":"Starts the final stage. Shows background 1 and changes the sprite images and a bitmap block."}
