  "comments": [
    {"at":0,"placement":"line","text":"Final stage: starts sprite 4 at the right on path $8a or $8b (random). When it reaches fighter 0, checks the move of fighter 0."},
    {"at":8,"placement":"side","text":"Sprite 4."},
    {"at":14,"placement":"side","text":"The program does not use this value: the next instruction loads A again."},
    {"at":16,"placement":"side","text":"Animation $15 with bit 7 set."},
    {"at":27,"placement":"side","text":"Random path: bit 0 of the raster line."},
    {"at":47,"placement":"side","text":"Sprite 4 starts at X $ff, Y $a2."},
    {"at":67,"placement":"side","text":"Sound effect $dd on all 3 voices."},
    {"at":76,"placement":"line","text":"Changes the pose of sprites 0-3 between set 0 and set 1."},
    {"at":82,"placement":"line","text":"Compares the X position of sprite 4 (in steps of 8 pixels, minus 6) with fighter 0."},
    {"at":101,"placement":"line","text":"Sprite 4 is at fighter 0. If fighter 0 does a move of the list for this path, sprite 4 stops. Else fighter 0 dies and the game ends."},
    {"at":105,"placement":"side","text":"List of 4 moves: $ccdb for path $8a, $ccdf for path $8b."},
    {"at":128,"placement":"line","text":"Fighter 0 gets move $1b, waits 150 frames and shows YOUR END HAS COME. Then the demo starts."},
    {"at":162,"placement":"line","text":"Stops sprite 4."},
    {"at":181,"placement":"line","text":"When fighter 0 is at X $1c or more, plays the end of the story with THANKS BIG BOY. Then the demo starts."},
    {"at":194,"placement":"side","text":"Move $00: stands."},
    {"at":204,"placement":"side","text":"Move $02: walks back to X $03."},
    {"at":233,"placement":"side","text":"Changes a bitmap block."},
    {"at":238,"placement":"side","text":"Pose set 2 for sprites 0-3."},
    {"at":243,"placement":"side","text":"Move $01: walks forward to X $17."},
    {"at":262,"placement":"side","text":"Move $13."},
    {"at":278,"placement":"side","text":"Text $8a: THANKS BIG BOY."},
    {"at":303,"placement":"line","text":"Starts move A for fighter 0: fighter_move_lock = A, fighter_move = A with bit 7, step 0."},
    {"at":314,"placement":"line","text":"Updates and draws both fighters for one frame. The main loop does the same steps."}
  ],
