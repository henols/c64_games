  "comments": [
    {"at":0,"placement":"line","text":"Moves sprites 7-0 by the direction bits in sprite_move_dirs: bit 0 up, 1 down, 2 left, 3 right."},
    {"at":2,"placement":"side","text":"Y = X * 2, the index of the sprite position."},
    {"at":42,"placement":"line","text":"Subtracts the Y speed from the Y of sprite X (Y = X * 2). The lowest Y is $32."},
    {"at":62,"placement":"line","text":"Adds the Y speed to the Y of sprite X (Y = X * 2). The highest Y is $e5."},
    {"at":82,"placement":"line","text":"Subtracts the X speed from the 9-bit X position of sprite X. Stops the sprite at the left edge."},
    {"at":99,"placement":"side","text":"Left of X = $38: stops the script and the animation and switches the sprite off."},
    {"at":121,"placement":"side","text":"X position 256 or more."},
    {"at":133,"placement":"side","text":"Clears the X bit 8 on a borrow."},
    {"at":141,"placement":"line","text":"Adds the X speed to the 9-bit X position of sprite X. Stops the sprite at the right edge."},
    {"at":158,"placement":"side","text":"Right of X = $12c: stops the animation and switches the sprite off."},
    {"at":174,"placement":"side","text":"Script value $85 stays active past the right edge. Other scripts stop."},
    {"at":189,"placement":"side","text":"X position below 256."},
    {"at":201,"placement":"side","text":"Sets the X bit 8 on a carry."}
  ],
