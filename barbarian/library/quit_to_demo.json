  "comments": [
    {"at":0,"placement":"line","text":"Stops the game: removes the sprites, restores the screen and restarts at $800e. The demo starts again."},
    {"at":7,"placement":"side","text":"Stops the scripts and animations of sprites 0-4."},
    {"at":16,"placement":"side","text":"Clears the text area of the screen."},
    {"at":19,"placement":"side","text":"Mirrors the fighter sprites back when they are mirrored."},
    {"at":30,"placement":"side","text":"Bit 7 of $bb: restores the screen areas of the end scene."},
    {"at":47,"placement":"side","text":"Goes back to scene 0 when scene 1 shows."},
    {"at":54,"placement":"side","text":"Resets the stack and runs the warm start. The music setting stays."}
