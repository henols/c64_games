  "comments": [
    {"at":0,"placement":"line","text":"At the start of a bout, walks both fighters in until the distance is less than 6. Then the bout starts."},
    {"at":21,"placement":"side","text":"Move $01: walks forward."},
    {"at":33,"placement":"side","text":"Sets the time to 60 seconds."},
    {"at":46,"placement":"side","text":"Starts the sound effects $89-$8b of the walk-in."},
    {"at":65,"placement":"side","text":"Starts the idle timers of both fighters."},
    {"at":73,"placement":"side","text":"With sound on, waits for the volume and starts the fade-in again."}
