  "comments": [
    {"at":0,"placement":"line","text":"Steps the corner animation of each fighter that has bit 7 set in its animation number."},
    {"at":13,"placement":"line","text":"Steps the corner animation of fighter X. The record gives the row, column, width, height and a list of frame words."},
    {"at":17,"placement":"side","text":"Record of the animation: table at $bc43."},
    {"at":35,"placement":"side","text":"Bitmap address of the row (table $7f7e)."},
    {"at":52,"placement":"side","text":"Adds 8 times the column (table $7fce)."},
    {"at":67,"placement":"side","text":"Width of the block in characters."},
    {"at":72,"placement":"side","text":"Height of the block in character rows."},
    {"at":76,"placement":"line","text":"Reads the next word of the record. A word of 4 or more is the address of a frame."},
    {"at":104,"placement":"line","text":"Word 0: starts the list again."},
    {"at":115,"placement":"line","text":"Word 1: continues at the offset in the next byte."},
    {"at":129,"placement":"line","text":"Word 2: starts the animation in the next byte."},
    {"at":146,"placement":"line","text":"Word 3: stops the animation."},
    {"at":153,"placement":"line","text":"Copies a frame of block_width x block_rows characters from copy_src_ptr to the bitmap at copy_dst_ptr."},
    {"at":194,"placement":"side","text":"Next character row of the bitmap: +$140."}
