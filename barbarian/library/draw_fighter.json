  "comments": [
    {"at":0,"placement":"line","text":"Draws the pose buffer of fighter $99 into the work bitmap at its column $71,x. Pixel pairs %00 are transparent. After a beaten fighter ($af bit 7), it uses the clipped version that draws only columns below 40."},
    {"at":16,"placement":"side","text":"Work bitmap address of the column: $a678 + 8 * column."},
    {"at":50,"placement":"side","text":"At each 8th line: next character row (offsets at $cf10)."},
    {"at":77,"placement":"side","text":"Mask from $03aa: keeps the background where the pixel pair is %00."},
    {"at":109,"placement":"side","text":"62 lines."},
    {"at":181,"placement":"side","text":"Columns 40 and more are off the screen."}
  ],
