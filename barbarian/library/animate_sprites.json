  "comments": [
    {"at":0,"placement":"line","text":"Runs the animation of each sprite 7-0 with sprite_anim bit 7 set, and switches that sprite on."},
    {"at":21,"placement":"line","text":"Steps the animation of sprite X. Sets the frame, colour, multicolour and expansion when the delay ends."},
    {"at":26,"placement":"side","text":"Gets the animation pointer from the table at $cbe8."},
    {"at":68,"placement":"side","text":"Byte 0: frame delay. Byte 1: bit 7 multicolour, bit 6 X expand, bit 5 Y expand, bits 0-3 colour."},
    {"at":123,"placement":"side","text":"Bytes from offset 2: frame numbers, or $ff and a command."},
    {"at":132,"placement":"side","text":"The sprite pointer is the frame number + $20."},
    {"at":144,"placement":"line","text":"Command after $ff: 0 restarts, 1 ends, 2 n goes to frame n, other n starts animation n."},
    {"at":157,"placement":"side","text":"Command 1: stops the animation and switches the sprite off."},
    {"at":176,"placement":"side","text":"Command 2: the next byte + 2 is the new offset."},
    {"at":192,"placement":"side","text":"Other command: the next byte is the new animation."}
  ],
