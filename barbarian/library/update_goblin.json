  "comments": [
    {"at":0,"placement":"line","text":"Runs the goblin events while goblin_active bit 7 is set. $91a7 starts the goblin as sprites 3 and 4."},
    {"at":14,"placement":"line","text":"When sprite 3 reaches sprite 0 and the dead fighter has state $88, sprites 0 and 1 get new scripts."},
    {"at":19,"placement":"side","text":"X = the index of the dead fighter."},
    {"at":30,"placement":"side","text":"Gets the 9-bit X of sprite 0 in $57/$58."},
    {"at":49,"placement":"side","text":"Gets the 9-bit X of sprite 3 plus 8 in $55/$56."},
    {"at":70,"placement":"side","text":"Gives sprites 1 and 0 the scripts at $cde8 and the animations at $cde0."},
    {"at":98,"placement":"side","text":"Requests sound $eb on the three voices when voice 1 is free."},
    {"at":114,"placement":"line","text":"While goblin_drags bit 7 is set: plays sounds $d4-$d6 and moves the dead fighter one column with sprite 3."},
    {"at":118,"placement":"side","text":"Requests sounds $d4-$d6 when voice 1 is free and does not play $d4."},
    {"at":141,"placement":"side","text":"Moves the body only when sprite 3 is on a character column."},
    {"at":152,"placement":"side","text":"Increments the column of the dead fighter (X from goblin_body_compare)."},
    {"at":155,"placement":"line","text":"When sprite 3 reaches the dead fighter, sprites 4 and 3 get new scripts and goblin_drags is set."},
    {"at":164,"placement":"side","text":"Gives sprites 4 and 3 the scripts at $cdea and the animations at $cde2."},
    {"at":195,"placement":"side","text":"Y is $ff here: sets goblin_drags."},
    {"at":197,"placement":"side","text":"Requests sound $e2 on voice 1."},
    {"at":202,"placement":"line","text":"Compares dead fighter column + 5 with sprite 3 column - 3. Out: CMP flags, X = dead fighter."},
    {"at":202,"placement":"side","text":"Bit 3 of sprite_x_msb is bit 8 of the sprite 3 X."},
    {"at":208,"placement":"side","text":"Divides the 9-bit X of sprite 3 by 8."}
  ],
